{
  "_comment": "**Stage: production** — Plaintext template — copy to production.enc.json and encrypt with `sops -e -i infra/secrets/production.enc.json`. Keep the keys in sync with `workerSecretSpecs()` in infra/src/secrets.ts.",
  "_dispatch_extras_comment": "Dispatch-extras (SECRET_BOX_MASTER_KEY, ADMIN_LLM_API_KEY, R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY) — required by the web and consumer workers for ingestion/export dispatch. Stage isolation: NEVER reuse SECRET_BOX_MASTER_KEY or R2 access tokens between staging and production — sharing the master key makes encrypted DB rows interchangeable across environments; sharing the R2 token broadens the blast radius of a leak. See ADR-005 of Issue #110.",
  "_web_only_comment": "ADMIN_SETUP_TOKEN gates AdminSignUp on the web worker only. The CI `wrangler secret bulk` push currently sends every key to every worker (ADR-007); consumer/relay/pruner/dlq ignore it until per-worker filter lands.",
  "BETTER_AUTH_SECRET": "<random-base64-32-bytes>",
  "GOOGLE_CLIENT_ID": "<google-oauth-client-id>.apps.googleusercontent.com",
  "GOOGLE_CLIENT_SECRET": "<google-oauth-client-secret>",
  "SECRET_BOX_MASTER_KEY": "<openssl rand -base64 32 — generate fresh per stage>",
  "ADMIN_LLM_API_KEY": "sk-ant-<anthropic-api-key>",
  "R2_ACCOUNT_ID": "<cloudflare-account-id>",
  "R2_ACCESS_KEY_ID": "<r2-api-token-access-key-id>",
  "R2_SECRET_ACCESS_KEY": "<r2-api-token-secret-access-key>",
  "ADMIN_SETUP_TOKEN": "<openssl rand -hex 32 — web-only bootstrap token>"
}
