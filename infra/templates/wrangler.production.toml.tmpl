# GENERATED FILE — do not edit by hand.
# Source template: infra/templates/wrangler.production.toml.tmpl
# Renderer:        infra/scripts/renderWrangler.ts
# Inputs:          Pulumi stack output (production)
#
# Wrangler does NOT inherit `d1_databases` / `vars` / `r2_buckets` /
# `services` from top level into named environments — every `[env.*]`
# block re-declares them. Keep `database_id`, queue names, bucket names,
# Service Binding targets, and `APP_URL` in sync across every block.
name = "${WORKER_WEB}"
# Point at the Vite-built artifact rather than raw TS. TanStack Start's server entry
# uses Vite-plugin virtual imports (#tanstack-router-entry, tanstack-start-manifest:v,
# etc.) that wrangler's esbuild cannot resolve when bundling from source. `no_bundle`
# tells wrangler to ship the already-bundled output as-is. See Issue #174.
main = "dist/server/index.js"
no_bundle = true
compatibility_date = "2026-05-01"
compatibility_flags = ["nodejs_compat"]

# With `no_bundle = true`, wrangler ships `main` as-is and does not auto-include the
# ESM chunks it imports (e.g. `dist/server/assets/*.js`). The local `wrangler.toml`
# generated by `@cloudflare/vite-plugin` injects these rules automatically, but the
# staging/production templates are read by bare wrangler, so we must declare them
# explicitly or upload fails with 10021 "No such module". See Issue #183.
[[rules]]
type = "ESModule"
globs = ["**/*.js", "**/*.mjs"]

# The web Worker's public hostname is bound via Cloudflare Workers
# Custom Domains, provisioned by Pulumi (`infra/src/dns.ts`). The legacy
# `routes = [...]` block is intentionally absent: Custom Domains own both
# the DNS record and the edge cert, so a `routes` declaration would race
# with the Pulumi-managed binding.

[assets]
directory = "./dist/client"
binding = "ASSETS"

[vars]
APP_URL = "${APP_URL}"
R2_OBJECT_BUCKET_NAME = "${R2_OBJECTS_BUCKET}"
ADMIN_LLM_MODEL = "${ADMIN_LLM_MODEL}"
ADMIN_LLM_PROVIDER = "${ADMIN_LLM_PROVIDER}"
ADMIN_LLM_BASE_URL = "${ADMIN_LLM_BASE_URL}"

[[d1_databases]]
binding = "DB"
database_name = "${D1_NAME}"
database_id = "${D1_ID}"
migrations_dir = "app/core/adapters/d1/migrations"

[[r2_buckets]]
binding = "TEMP_FILES"
bucket_name = "${R2_TEMP_FILES_BUCKET}"

[[r2_buckets]]
binding = "OBJECT_STORAGE"
bucket_name = "${R2_OBJECTS_BUCKET}"

[[services]]
binding = "RELAY"
service = "${WORKER_RELAY}"


# === Relay (Service Binding fetch + safety-net cron) ====================
[env.relay]
name = "${WORKER_RELAY}"
main = "app/worker/cloudflare/relay.ts"
compatibility_date = "2026-05-01"
compatibility_flags = ["nodejs_compat"]
# Sub-Worker bundles its TS entry; the top-level `no_bundle = true`
# (used because the main Worker ships a Vite-built artifact) does NOT
# inherit into envs that point at raw `.ts` files, so we override here.
# Without this, wrangler would upload `app/worker/cloudflare/*.ts` raw
# and Cloudflare would reject the script with a SyntaxError [code: 10021].
no_bundle = false

[env.relay.vars]
APP_URL = "${APP_URL}"
OUTBOX_BATCH_SIZE = "100"
OUTBOX_LEASE_MS = "300000"   # 5 min — covers worst-case single-batch dispatch
OUTBOX_MAX_ATTEMPTS = "2"    # multiplied by [env.consumer] max_retries — keep low

[[env.relay.d1_databases]]
binding = "DB"
database_name = "${D1_NAME}"
database_id = "${D1_ID}"
migrations_dir = "app/core/adapters/d1/migrations"

[[env.relay.queues.producers]]
binding = "EVENTS_QUEUE"
queue = "${EVENTS_QUEUE}"

[env.relay.triggers]
crons = ["*/5 * * * *"]


# === Consumer ===========================================================
[env.consumer]
name = "${WORKER_CONSUMER}"
main = "app/worker/cloudflare/consumer.ts"
compatibility_date = "2026-05-01"
compatibility_flags = ["nodejs_compat"]
# Sub-Worker bundles its TS entry; the top-level `no_bundle = true`
# (used because the main Worker ships a Vite-built artifact) does NOT
# inherit into envs that point at raw `.ts` files, so we override here.
# Without this, wrangler would upload `app/worker/cloudflare/*.ts` raw
# and Cloudflare would reject the script with a SyntaxError [code: 10021].
no_bundle = false

[env.consumer.vars]
APP_URL = "${APP_URL}"
R2_OBJECT_BUCKET_NAME = "${R2_OBJECTS_BUCKET}"
ADMIN_LLM_MODEL = "${ADMIN_LLM_MODEL}"
ADMIN_LLM_PROVIDER = "${ADMIN_LLM_PROVIDER}"
ADMIN_LLM_BASE_URL = "${ADMIN_LLM_BASE_URL}"

[[env.consumer.d1_databases]]
binding = "DB"
database_name = "${D1_NAME}"
database_id = "${D1_ID}"
migrations_dir = "app/core/adapters/d1/migrations"

[[env.consumer.r2_buckets]]
binding = "TEMP_FILES"
bucket_name = "${R2_TEMP_FILES_BUCKET}"

[[env.consumer.r2_buckets]]
binding = "OBJECT_STORAGE"
bucket_name = "${R2_OBJECTS_BUCKET}"

[[env.consumer.services]]
binding = "RELAY"
service = "${WORKER_RELAY}"

[[env.consumer.queues.consumers]]
queue = "${EVENTS_QUEUE}"
max_batch_size = 25
max_batch_timeout = 30 # seconds
max_retries = 3
dead_letter_queue = "${EVENTS_DLQ_QUEUE}"


# === Indexer ============================================================
[env.indexer]
name = "${WORKER_INDEXER}"
main = "app/worker/cloudflare/indexer.ts"
compatibility_date = "2026-05-01"
compatibility_flags = ["nodejs_compat"]
# Sub-Worker bundles its TS entry; the top-level `no_bundle = true`
# (used because the main Worker ships a Vite-built artifact) does NOT
# inherit into envs that point at raw `.ts` files, so we override here.
# Without this, wrangler would upload `app/worker/cloudflare/*.ts` raw
# and Cloudflare would reject the script with a SyntaxError [code: 10021].
no_bundle = false

[env.indexer.vars]
APP_URL = "${APP_URL}"
INDEXER_BATCH_SIZE = "50"
INDEXER_MAX_BATCHES = "20"

[[env.indexer.d1_databases]]
binding = "DB"
database_name = "${D1_NAME}"
database_id = "${D1_ID}"
migrations_dir = "app/core/adapters/d1/migrations"

[env.indexer.triggers]
crons = ["*/5 * * * *"]


# === Pruner =============================================================
[env.pruner]
name = "${WORKER_PRUNER}"
main = "app/worker/cloudflare/pruner.ts"
compatibility_date = "2026-05-01"
compatibility_flags = ["nodejs_compat"]
# Sub-Worker bundles its TS entry; the top-level `no_bundle = true`
# (used because the main Worker ships a Vite-built artifact) does NOT
# inherit into envs that point at raw `.ts` files, so we override here.
# Without this, wrangler would upload `app/worker/cloudflare/*.ts` raw
# and Cloudflare would reject the script with a SyntaxError [code: 10021].
no_bundle = false

[env.pruner.vars]
APP_URL = "${APP_URL}"
OUTBOX_RETENTION_MS = "604800000"   # 7 days

[[env.pruner.d1_databases]]
binding = "DB"
database_name = "${D1_NAME}"
database_id = "${D1_ID}"
migrations_dir = "app/core/adapters/d1/migrations"

[env.pruner.triggers]
crons = ["0 3 * * *"] # 03:00 UTC daily


# === DLQ ================================================================
[env.dlq]
name = "${WORKER_DLQ}"
main = "app/worker/cloudflare/dlq.ts"
compatibility_date = "2026-05-01"
compatibility_flags = ["nodejs_compat"]
# Sub-Worker bundles its TS entry; the top-level `no_bundle = true`
# (used because the main Worker ships a Vite-built artifact) does NOT
# inherit into envs that point at raw `.ts` files, so we override here.
# Without this, wrangler would upload `app/worker/cloudflare/*.ts` raw
# and Cloudflare would reject the script with a SyntaxError [code: 10021].
no_bundle = false

[env.dlq.vars]
APP_URL = "${APP_URL}"

[[env.dlq.d1_databases]]
binding = "DB"
database_name = "${D1_NAME}"
database_id = "${D1_ID}"
migrations_dir = "app/core/adapters/d1/migrations"

[[env.dlq.queues.consumers]]
queue = "${EVENTS_DLQ_QUEUE}"
max_batch_size = 25
max_batch_timeout = 30 # seconds
max_retries = 1
