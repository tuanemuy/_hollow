{
  "name": "hollow",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "wrangler types",
    "predev": "wrangler types",
    "dev": "vite dev --config vite.config.cloudflare.ts",
    "build": "vite build --config vite.config.cloudflare.ts",
    "build:local": "NODE_ENV=production vite build --mode development --config vite.config.cloudflare.ts",
    "start": "wrangler dev",
    "preview": "vite preview --config vite.config.cloudflare.ts",
    "typecheck": "tsgo",
    "lint": "biome lint",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "cf:types": "wrangler types",
    "deploy:staging": "vite build --config vite.config.cloudflare.ts && wrangler deploy --config wrangler.staging.toml",
    "deploy:staging:dry": "vite build --config vite.config.cloudflare.ts && wrangler deploy --config wrangler.staging.toml --dry-run --outdir=dist/worker",
    "deploy:staging:relay": "wrangler deploy --config wrangler.staging.toml --env relay",
    "deploy:staging:relay:dry": "wrangler deploy --config wrangler.staging.toml --env relay --dry-run --outdir=dist/relay",
    "deploy:staging:consumer": "wrangler deploy --config wrangler.staging.toml --env consumer",
    "deploy:staging:consumer:dry": "wrangler deploy --config wrangler.staging.toml --env consumer --dry-run --outdir=dist/consumer",
    "deploy:staging:pruner": "wrangler deploy --config wrangler.staging.toml --env pruner",
    "deploy:staging:pruner:dry": "wrangler deploy --config wrangler.staging.toml --env pruner --dry-run --outdir=dist/pruner",
    "deploy:staging:dlq": "wrangler deploy --config wrangler.staging.toml --env dlq",
    "deploy:staging:dlq:dry": "wrangler deploy --config wrangler.staging.toml --env dlq --dry-run --outdir=dist/dlq",
    "deploy:staging:indexer": "wrangler deploy --config wrangler.staging.toml --env indexer",
    "deploy:staging:indexer:dry": "wrangler deploy --config wrangler.staging.toml --env indexer --dry-run --outdir=dist/indexer",
    "deploy:staging:all": "pnpm deploy:staging && pnpm deploy:staging:relay && pnpm deploy:staging:consumer && pnpm deploy:staging:indexer && pnpm deploy:staging:pruner && pnpm deploy:staging:dlq",
    "deploy:staging:all:dry": "pnpm deploy:staging:dry && pnpm deploy:staging:relay:dry && pnpm deploy:staging:consumer:dry && pnpm deploy:staging:indexer:dry && pnpm deploy:staging:pruner:dry && pnpm deploy:staging:dlq:dry",
    "deploy:production": "vite build --config vite.config.cloudflare.ts && wrangler deploy --config wrangler.production.toml",
    "deploy:production:dry": "vite build --config vite.config.cloudflare.ts && wrangler deploy --config wrangler.production.toml --dry-run --outdir=dist/worker",
    "deploy:production:relay": "wrangler deploy --config wrangler.production.toml --env relay",
    "deploy:production:relay:dry": "wrangler deploy --config wrangler.production.toml --env relay --dry-run --outdir=dist/relay",
    "deploy:production:consumer": "wrangler deploy --config wrangler.production.toml --env consumer",
    "deploy:production:consumer:dry": "wrangler deploy --config wrangler.production.toml --env consumer --dry-run --outdir=dist/consumer",
    "deploy:production:pruner": "wrangler deploy --config wrangler.production.toml --env pruner",
    "deploy:production:pruner:dry": "wrangler deploy --config wrangler.production.toml --env pruner --dry-run --outdir=dist/pruner",
    "deploy:production:dlq": "wrangler deploy --config wrangler.production.toml --env dlq",
    "deploy:production:dlq:dry": "wrangler deploy --config wrangler.production.toml --env dlq --dry-run --outdir=dist/dlq",
    "deploy:production:indexer": "wrangler deploy --config wrangler.production.toml --env indexer",
    "deploy:production:indexer:dry": "wrangler deploy --config wrangler.production.toml --env indexer --dry-run --outdir=dist/indexer",
    "deploy:production:all": "pnpm deploy:production && pnpm deploy:production:relay && pnpm deploy:production:consumer && pnpm deploy:production:indexer && pnpm deploy:production:pruner && pnpm deploy:production:dlq",
    "deploy:production:all:dry": "pnpm deploy:production:dry && pnpm deploy:production:relay:dry && pnpm deploy:production:consumer:dry && pnpm deploy:production:indexer:dry && pnpm deploy:production:pruner:dry && pnpm deploy:production:dlq:dry",
    "infra:render:staging": "pnpm --filter @hollow/infra render:staging",
    "infra:render:production": "pnpm --filter @hollow/infra render:production",
    "infra:check-secrets:staging": "pnpm --filter @hollow/infra check-secrets:staging",
    "infra:check-secrets:production": "pnpm --filter @hollow/infra check-secrets:production",
    "infra:preview:staging": "pnpm --filter @hollow/infra preview:staging",
    "infra:preview:production": "pnpm --filter @hollow/infra preview:production",
    "infra:up:staging": "pnpm --filter @hollow/infra up:staging",
    "infra:up:production": "pnpm --filter @hollow/infra up:production",
    "db:migrate": "wrangler d1 migrations apply hollow-local-d1 --local",
    "db:generate": "drizzle-kit generate --config=./drizzle.config.ts",
    "db:apply:local": "wrangler d1 migrations apply hollow-local-d1 --local",
    "db:apply:staging": "wrangler d1 migrations apply hollow-staging-d1 --remote --config wrangler.staging.toml",
    "db:apply:production": "wrangler d1 migrations apply hollow-production-d1 --remote --config wrangler.production.toml",
    "db:execute:local": "wrangler d1 execute hollow-local-d1 --local --file",
    "seed:dev-admin": "node scripts/seed-dev-admin.mjs",
    "db:execute:staging": "wrangler d1 execute hollow-staging-d1 --remote --config wrangler.staging.toml --file",
    "db:execute:production": "wrangler d1 execute hollow-production-d1 --remote --config wrangler.production.toml --file"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@shikijs/langs": "^4.2.0",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-start": "^1.168.25",
    "@tiptap/extension-image": "^3.23.4",
    "@tiptap/extension-link": "^3.23.4",
    "@tiptap/extension-mention": "^3.23.4",
    "@tiptap/pm": "^3.23.4",
    "@tiptap/react": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "@tiptap/suggestion": "^3.23.4",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "markdown-it": "14.2.0",
    "markdown-it-attrs": "5.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shiki": "^4.2.0",
    "ultrahtml": "1.6.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@cloudflare/vite-plugin": "^1.36.4",
    "@cloudflare/vitest-pool-workers": "^0.16.4",
    "@cloudflare/workers-types": "^4.20260511.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^25.7.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260513.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitejs/plugin-rsc": "^0.5.26",
    "drizzle-kit": "^0.31.10",
    "fast-check": "^4.8.0",
    "happy-dom": "^20.9.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6",
    "wrangler": "^4.90.1"
  }
}
