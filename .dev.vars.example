# Wrangler `.dev.vars` template — copy to `.dev.vars` for local development.
#
#   cp .dev.vars.example .dev.vars
#
# `wrangler dev` (including the workerd-backed `pnpm dev` via
# `@cloudflare/vite-plugin`) auto-loads this file from the project root
# and exposes each entry as a Worker binding, mirroring `wrangler secret
# put` for production. Never commit the real `.dev.vars` — it is listed
# in `.gitignore`.
#
# Non-secret config (e.g. `APP_URL`) belongs in `wrangler.toml` `[vars]`,
# not here. Reserve this file for credentials and tokens that must not
# be checked in.
#
# Keep this key set in sync with `infra/src/secrets.ts`
# (`workerSecretSpecs`). Adding a key there without adding it here will
# break `pnpm dev` for the next contributor who pulls.

# --- Better Auth ----------------------------------------------------------
# Shared secret used to sign session / CSRF tokens. Generate with:
#   openssl rand -base64 32
# Any non-empty value works for local dev; just don't reuse production.
BETTER_AUTH_SECRET="dev-only-replace-me-with-openssl-rand-base64-32"

# --- Google OAuth ---------------------------------------------------------
# OAuth 2.0 Web application credentials from Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
#
# For local dev, create a dedicated OAuth client with:
#   Authorized JavaScript origins: http://localhost:3000
#   Authorized redirect URIs:      http://localhost:3000/api/auth/callback/google
#
# Production / staging credentials are managed via `sops` under
# `infra/secrets/{stage}.enc.json`; do NOT paste those values here.
GOOGLE_CLIENT_ID="your-local-dev-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-local-dev-client-secret"

# --- Admin sign-up bootstrap token (web only) ----------------------------
# Optional bearer that gates `AdminSignUp`. When unset, admin sign-up
# returns `AuthenticationError("setup_token_disabled")` — useful in
# local dev where you don't need bootstrap protection. Generate with:
#   openssl rand -hex 32
# Production / staging values live in `infra/secrets/{stage}.enc.json`
# under the same key.
ADMIN_SETUP_TOKEN=""

# --- SecretBox master key (at-rest encryption) ----------------------------
# AES-256 master key for encrypting at-rest secrets such as DB-sourced LLM
# api keys (e.g. saving `apiKeySource = 'db'` from `/admin/llm`). MUST be a
# base64-encoded 32-byte value — the worker rejects malformed keys at boot.
# See `app/core/adapters/security/secretBox.ts` for the wire format.
#
# Required for the admin UI to round-trip a saved LLM api key through the
# encrypted DB row. When empty, DI falls back to `NullSecretBox` and every
# encrypt/decrypt surfaces `SecretBoxError(KeyUnavailable)` — the admin UI
# still renders, but saving a DB-sourced api key fails at call time.
#
# Generate a fresh value with:
#   openssl rand -base64 32
#
# The default below is a valid base64 32-byte placeholder so a fresh
# `cp .dev.vars.example .dev.vars` is immediately usable for local dev.
# *** LOCAL DEV ONLY — never reuse this value in staging or production. ***
# Production / staging keys are provisioned via `wrangler secret bulk` from
# `infra/secrets/{stage}.enc.json` (listed in `infra/src/secrets.ts`
# `workerSecretSpecs` as of Issue #110).
SECRET_BOX_MASTER_KEY="ZGV2LW9ubHktZG8tbm90LXVzZS1pbi1wcm9kLWRvLTE="

# --- LLM provider env override -------------------------------------------
# 4 paired vars selecting the LLM / OCR / PDF provider:
#   ADMIN_LLM_PROVIDER : "anthropic" | "openai" | "gemini"
#   ADMIN_LLM_MODEL    : provider-specific model id
#   ADMIN_LLM_BASE_URL : OpenAI-compatible endpoint base URL (only honoured
#                        by the `openai` provider; ignored otherwise)
#   ADMIN_LLM_API_KEY  : provider-specific API key
#
# DI wires the real adapter only when ADMIN_LLM_API_KEY *and*
# ADMIN_LLM_MODEL are both present and non-empty. Either missing → falls
# back to `Stub*`, which rejects every call with
# `BusinessRuleError("unsupported_format")`. Leave empty for purely local
# dev; calls to any provider are billed.
#
# When any of these env vars is set, the `/admin/llm` UI surfaces the
# corresponding field as "環境変数で固定中" (env-locked) and silently
# preserves the persisted DB value on save — env > DB at runtime per
# Issue #101 ADR-007.
#
# API key formats by provider:
#   Anthropic : sk-ant-api03-...
#   OpenAI    : sk-... (本家) / プロバイダ固有 (Groq, vLLM, Azure 等)
#   Gemini    : AIza...
#
# --- Example: Anthropic (default) ---------------------------------------
# ADMIN_LLM_PROVIDER="anthropic"
# ADMIN_LLM_MODEL="claude-sonnet-4-5"
# ADMIN_LLM_BASE_URL=""
# ADMIN_LLM_API_KEY="sk-ant-api03-..."
#
# --- Example: OpenAI 本家 -----------------------------------------------
# ADMIN_LLM_PROVIDER="openai"
# ADMIN_LLM_MODEL="gpt-4o"
# ADMIN_LLM_BASE_URL=""
# ADMIN_LLM_API_KEY="sk-..."
#
# --- Example: Groq (OpenAI-compatible) ----------------------------------
# ADMIN_LLM_PROVIDER="openai"
# ADMIN_LLM_MODEL="llama-3.3-70b-versatile"
# ADMIN_LLM_BASE_URL="https://api.groq.com/openai/v1"
# ADMIN_LLM_API_KEY="gsk_..."
#
# --- Example: Google Gemini ---------------------------------------------
# ADMIN_LLM_PROVIDER="gemini"
# ADMIN_LLM_MODEL="gemini-1.5-pro"
# ADMIN_LLM_BASE_URL=""
# ADMIN_LLM_API_KEY="AIza..."
ADMIN_LLM_API_KEY=""

# --- R2 SigV4 presign credentials ---------------------------------------
# Required by `R2ObjectStorage` to mint short-lived presigned URLs for
# export downloads. Issue via Cloudflare dashboard → R2 → "Manage R2
# API Tokens"; for local dev, scope a read/write token to the dev
# `tanstack-start-template-objects` bucket only.
#
# All three (plus the `OBJECT_STORAGE` binding from `wrangler.toml` and
# the `R2_OBJECT_BUCKET_NAME` var) must be set together for DI to wire
# `R2ObjectStorage`. Any one empty → falls back to `StubObjectStorage`,
# which rejects every call with `StorageUnavailableError`. The
# data-plane `TEMP_FILES` binding still works without these credentials.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
