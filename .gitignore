.DS_Store
/node_modules/

# TanStack Start / Vite
/.tanstack/
/.output/
/.nitro/
/dist/

# Cloudflare Wrangler
/.wrangler/
/worker-configuration.d.ts
/.dev.vars

# Generated wrangler configs — rendered from infra/templates/*.tmpl + Pulumi outputs.
# See infra/scripts/renderWrangler.ts and `.github/workflows/deploy-*.yml`.
/wrangler.staging.toml
/wrangler.production.toml

# Pulumi local state / venv — Pulumi Cloud is the configured backend, but
# leftover local artifacts can appear from `pulumi login --local` experiments.
/infra/node_modules/
/infra/.pulumi/

.envrc
.direnv

*.db
*.db-shm
*.db-wal

# manual-test execution artifacts (seed scripts and docs are tracked;
# results/screenshots/server-info are run-local and noisy)
/.manual-test/*/results/
/.manual-test/*/screenshots/
/.manual-test/*/server-info.md

# Manual test screenshots under .issue/
.issue/**/screenshots/
.issue/**/.manual-test/**/*.png
.issue/**/.manual-test/**/*.jpg
.issue/**/.manual-test/**/*.jpeg
.issue/**/.manual-test/**/*.gif
.issue/**/.manual-test/**/*.webp
.issue/**/manual-test/*.png
.issue/**/manual-test/*.jpg
.issue/**/manual-test/*.jpeg
.issue/**/manual-test/*.gif
.issue/**/manual-test/*.webp
